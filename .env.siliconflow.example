# DeepSeek chat, embeddings and reranking through SiliconFlow.
# Copy to .env and fill only SILICONFLOW_API_KEY locally.
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

CUSTOMER_SUPPORT_MODE=compatible
COMPATIBLE_API_KEY=${SILICONFLOW_API_KEY}
COMPATIBLE_BASE_URL=${SILICONFLOW_BASE_URL}
# Documented example; verify availability with your account before running.
COMPATIBLE_MODEL=deepseek-ai/DeepSeek-V4-Flash
DEFAULT_MODEL=openai-compatible

RAG_EMBEDDING_PROVIDER=siliconflow
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_RERANK_ENABLED=true
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_RELEVANCE_THRESHOLD=0.50

DATABASE_TYPE=sqlite
SQLITE_DB_PATH=data/checkpoints.db
OLIST_DB_PATH=data/olist_support.db
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO

# Docker Compose supplies BUSINESS_DATABASE_TYPE=mysql to the service.
MYSQL_DATABASE=ecommerce_support
MYSQL_USER=support_app
MYSQL_EXPOSED_PORT=3306
